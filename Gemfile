source "https://rubygems.org"

# GitHub Pages — when this version matches what Pages itself uses, local
# previews behave identically to the deployed site.
gem "github-pages", group: :jekyll_plugins

# Just the Docs theme + plugins listed in _config.yml.
group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-seo-tag"
end
